{
  "name": "defense-budget-intelligence",
  "version": "0.1.0",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Defense budget and spend intelligence platform for service, Fourth Estate, and color-of-money analytics.",
  "scripts": {
    "dev": "npm run data:runtime && vite --host 0.0.0.0",
    "build": "npm run data:runtime && vite build",
    "build:cloudflare": "VITE_BASE_PATH=/ npm run build",
    "start": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "container:up": "docker compose up --build -d",
    "container:down": "docker compose down",
    "container:verify": "node scripts/verify-container.mjs",
    "data:build": "node scripts/build-budget-data.mjs",
    "data:runtime": "node scripts/build-runtime-data.mjs",
    "data:delta": "node scripts/build-refresh-delta.mjs",
    "data:procurement-delta": "node scripts/build-procurement-delta.mjs",
    "source:workbooks": "node scripts/fetch-budget-workbooks.mjs",
    "source:justifications": "node scripts/fetch-justification-sources.mjs",
    "source:usaspending": "node scripts/fetch-usaspending-awards.mjs",
    "source:subawards": "node scripts/fetch-usaspending-subawards.mjs",
    "source:account-spine": "node scripts/fetch-account-spine.mjs",
    "source:sam": "node scripts/fetch-sam-opportunities.mjs",
    "source:refresh": "npm run source:workbooks && npm run source:justifications && npm run source:usaspending && npm run data:build && npm run source:subawards && npm run source:sam && npm run source:account-spine && npm run source:health",
    "source:health": "node scripts/check-source-health.mjs",
    "lint": "eslint .",
    "verify": "npm run lint && npm run build && node scripts/verify-site.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:pages-auth": "npm run build:cloudflare && node scripts/verify-pages-auth.mjs",
    "verify:prod-interactions": "BUDGET_VERIFY_URL=https://defense-budget-intelligence.pages.dev/ node scripts/verify-site.mjs",
    "verify:prod-smoke": "node scripts/prod-smoke.mjs",
    "pages:dev": "npm run build:cloudflare && wrangler pages dev dist",
    "pages:deploy": "npm run build:cloudflare && wrangler pages deploy dist --project-name defense-budget-intelligence",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "d3": "^7.9.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lucide-react": "^0.542.0",
    "playwright-core": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.16",
    "wrangler": "^4.131.1"
  }
}
