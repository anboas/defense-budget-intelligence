FROM postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873

# The service always runs as postgres, so the root-only privilege-drop helper is unnecessary.
# Pin the patched Alpine revision until the upstream Postgres image incorporates it.
RUN apk update \
  && apk add --no-cache --upgrade zlib=1.3.2-r1 \
  && rm -f /usr/local/bin/gosu

USER postgres
